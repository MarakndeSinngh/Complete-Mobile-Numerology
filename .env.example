# .env.example
GEMINI_API_KEY=

# Supabase / PostgreSQL Database Connection (Server-Side Only - Never prefix with VITE_)
# Use direct connection URL (port 5432) or Supabase Connection Pooler URL (Transaction Mode, port 6543)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Alternative connection aliases supported:
# SUPABASE_DB_URL=postgresql://...
# POSTGRES_URL=postgresql://...

# Razorpay Payment Gateway (Test Mode / Sandbox)
# Set these in your environment / Vercel Project Settings
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Fast2SMS / External SMS Gateway (Optional - for live SMS dispatch)
FAST2SMS_API_KEY=
